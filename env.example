# Configurações do Servidor
NODE_ENV=development
PORT=3000
HOST=localhost

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pobrefy_streaming?retryWrites=true&w=majority
MONGODB_SHARD_URI_1=mongodb+srv://username:password@shard1.mongodb.net/pobrefy_shard1?retryWrites=true&w=majority
MONGODB_SHARD_URI_2=mongodb+srv://username:password@shard2.mongodb.net/pobrefy_shard2?retryWrites=true&w=majority
MONGODB_SHARD_URI_3=mongodb+srv://username:password@shard3.mongodb.net/pobrefy_shard3?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# Redis Configuration (para cache e sessões)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# File Upload Configuration
MAX_FILE_SIZE=100MB
UPLOAD_PATH=./uploads
TEMP_PATH=./temp

# Streaming Configuration
STREAMING_BASE_URL=http://localhost:3000/stream
HLS_SEGMENT_DURATION=10
HLS_PLAYLIST_SIZE=6

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log
